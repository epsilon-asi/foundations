{
  "compilerOptions": {
    "target": "es2016",
    "module": "nodenext",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "esnext.decorators"],
    "rootDir": "./src",
    "declaration": true,
    "outDir": "./build",
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "moduleResolution": "nodenext"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "src/type-tests/**", "src/**/*.test.ts", "src/**/*.type-test.ts", "src/**/*.test-d.ts"]
}
