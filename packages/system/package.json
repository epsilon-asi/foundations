{
  "name": "@epsilon-asi/system",
  "version": "0.0.7",
  "description": "",
  "mainDir": "./",
  "scripts": {
    "build": "tsc && cp package.json ./build",
    "build:clean": "rm -rf ./build && npm run build",
    "typecheck": "tsc -p tsconfig.type-tests.json",
    "typecheck:tests": "npm run typecheck --",
    "start:dev": "npx nodemon --exec \"npx tsc\" --watch src -e ts",
    "test": "export IS_TEST='true' && jest --clearCache && jest --coverage --detectOpenHandles",
    "test:package": "sh tests/packed-root.sh",
    "test:watch": "export IS_TEST='true' && jest --clearCache && jest --coverage --detectOpenHandles --watchAll",
    "verify": "npm run typecheck && npm test && npm run build:clean && npm run test:package",
    "bump": "../../scripts/bump_version.sh",
    "pub": "npm run build && npm run bump && corepack pnpm publish --no-git-checks --access public"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "jest": {
    "clearMocks": true,
    "maxWorkers": 1,
    "preset": "ts-jest",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": ["<rootDir>/build/"],
    "testMatch": [
      "**/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/*.type-test.ts",
      "!src/**/__tests__/**",
      "!src/type-tests/**",
      "!src/examples/**",
      "!src/decorators/factory/examples/**",
      "!src/index.ts",
      "!build"
    ]
  },
  "dependencies": {
    "@epsilon-asi/foundation": "workspace:^",
    "@google-cloud/pubsub": "^5.3.0",
    "@mikro-orm/core": "^7.1.4",
    "@mikro-orm/decorators": "^7.1.4",
    "@mikro-orm/postgresql": "^7.1.4",
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "redis": "^6.0.0",
    "ts-deepmerge": "^8.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
