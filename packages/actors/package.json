{
  "name": "@epsilon-asi/actors",
  "version": "0.0.74",
  "description": "A TypeScript Puppeteer actor framework using existing Chrome profiles and ghost-cursor.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "paf": "./dist/cli/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "npx tsx ./src/cli/run.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test",
    "bump": "../../scripts/bump_version.sh",
    "pub": "npm run bump && npm publish --access public",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "ghost-cursor": "^1.4.2",
    "puppeteer-core": "24.43.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.7",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "SEE LICENSE IN LICENSE"
}
