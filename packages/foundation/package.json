{
  "name": "@epsilon-asi/foundation",
  "version": "0.0.13",
  "type": "module",
  "sideEffects": false,
  "description": "",
  "mainDir": "./",
  "types": "./build/index.d.ts",
  "typesVersions": {
    "*": {
      "env": [
        "./build/env/index.d.ts"
      ],
      "files": [
        "./build/files/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf ./build && npm run build",
    "typecheck": "tsc -p tsconfig.type-tests.json --noEmit",
    "typecheck:tests": "npm run typecheck --",
    "examples": "npm run build && node build/decorators/factory/examples/runExamples.js",
    "start:dev": "npx nodemon --exec \"npx tsc\" --watch src -e ts",
    "test": "export IS_TEST='true' NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" && jest --clearCache && jest --coverage --detectOpenHandles",
    "test:watch": "npm test -- --watchAll",
    "check:browser": "npm run build && node tests/check-browser.mjs && tsc -p tsconfig.browser.json",
    "verify": "npm run typecheck && npm run examples && npm run test && npm run check:browser",
    "bump": "../../scripts/bump_version.sh",
    "pub": "npm run build && npm run bump && npm publish --access public"
  },
  "jest": {
    "clearMocks": true,
    "maxWorkers": 1,
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "testMatch": [
      "**/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!.ai/**/*",
      "!src/**/*.type-test.ts",
      "!src/**/__tests__/**",
      "!src/type-tests/**",
      "!src/examples/**",
      "!src/decorators/factory/examples/**",
      "!src/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.js"
    },
    "./env": {
      "types": "./build/env/index.d.ts",
      "import": "./build/env/index.js",
      "require": "./build/env/index.js"
    },
    "./files": {
      "types": "./build/files/index.d.ts",
      "import": "./build/files/index.js",
      "require": "./build/files/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "dotenv": "^17.4.2",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@jest/globals": "30.3.0"
  }
}
