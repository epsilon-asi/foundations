{
  "compilerOptions": {
    "target": "es2016",
    "module": "nodenext",
    "lib": ["ES2022", "DOM", "esnext.decorators"],
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "moduleResolution": "nodenext"
  },
  "include": ["src/**/*.ts"]
}
