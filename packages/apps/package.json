{
  "name": "@epsilon-asi/apps",
  "version": "0.0.7",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "rm -rf ./build && tsc -p tsconfig.build.json",
    "build:clean": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.type-tests.json",
    "typecheck:tests": "npm run typecheck --",
    "start:dev": "npx nodemon --exec \"npm run build\" --watch src -e ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "test:import": "node tests/import.mjs",
    "check:browser": "npm run build && node tests/check-browser.mjs && tsc -p tsconfig.browser.json",
    "verify": "npm run typecheck && npm test && npm run check:browser && npm run test:import",
    "bump": "../../scripts/bump_version.sh",
    "pub": "npm run build && npm run bump && corepack pnpm publish --no-git-checks --access public"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "docs/CONVENTIONS.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@epsilon-asi/foundation": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "@mikro-orm/core": "^7.1.4",
    "@mikro-orm/migrations": "^7.1.4",
    "express": "^5.3.0",
    "redis": "^6.0.0",
    "stripe": "^23.1.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/pubsub": {
      "optional": true
    },
    "@mikro-orm/core": {
      "optional": true
    },
    "@mikro-orm/migrations": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@epsilon-asi/command-line": "workspace:^",
    "@mikro-orm/postgresql": "^7.1.4",
    "@mikro-orm/sqlite": "^7.1.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
